{
  "name": "orbit-web",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "start": "vite preview --host 0.0.0.0 --port 3000",
    "preview": "vite preview --host 0.0.0.0 --port 3000",
    "typecheck": "tsc --noEmit",
    "gen:events": "node scripts/gen-events.mjs",
    "test:e2e": "playwright test",
    "perf:chat": "playwright test -c playwright.perf.config.ts",
    "fixture:chat": "vite build && FIXTURE_MESSAGES=1000 FIXTURE_REPLY_CHARS=50000 STATIC_DIR=dist node e2e/fake-control.mjs",
    "test:api-smoke": "node scripts/api-smoke.mjs"
  },
  "dependencies": {
    "@tanstack/react-virtual": "^3.14.13",
    "clsx": "^2.1.1",
    "dompurify": "^3.4.16",
    "hast-util-from-dom": "^5.0.1",
    "hast-util-to-html": "^9.0.5",
    "hast-util-to-jsx-runtime": "^2.3.6",
    "katex": "^0.18.9",
    "lowlight": "^3.3.0",
    "lucide-react": "^0.483.0",
    "mermaid": "^11.17.2",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "react-markdown": "^10.1.0",
    "react-router": "^8.3.1",
    "rehype-katex": "^7.0.1",
    "rehype-sanitize": "^6.0.0",
    "remark-gfm": "^4.0.1",
    "remark-math": "^6.0.0",
    "tailwind-merge": "^3.0.2",
    "zustand": "^5.0.14"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@types/hast": "^3.0.5",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.0",
    "autoprefixer": "^10.4.21",
    "json-schema-to-typescript": "^16.0.0",
    "postcss": "^8.5.3",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.9.3",
    "vite": "^8.0.3"
  }
}
